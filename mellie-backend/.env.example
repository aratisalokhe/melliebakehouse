# ---------- Local development (defaults work out of the box) ----------
PORT=4000
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---------- Vercel deployment ----------
# 1. Create a free cloud database at https://turso.tech (it's SQLite in the cloud),
#    then run:  turso db create mellie  &&  turso db show mellie --url
#    and:       turso db tokens create mellie
# 2. Put both values here AND in your Vercel project's Environment Variables:
# DATABASE_URL=libsql://mellie-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=<long token from turso>
# 3. In Vercel → your project → Storage → create a "Blob" store and connect it.
#    Vercel then injects BLOB_READ_WRITE_TOKEN automatically (used for photo uploads).
# 4. Add JWT_SECRET (a long random string) to Vercel's Environment Variables too.

# Set to true to completely hide the admin console + admin APIs from the hosted
# site. Leave it unset on Vercel if you want to manage content from the hosted
# console (it is always protected by the admin login).
PUBLIC_DEPLOY=false

# Credentials used only by `npm run seed` to create the first admin account.
# IMPORTANT: change ADMIN_PASSWORD before hosting, and use the same values in
# Vercel's Environment Variables so your hosted login matches.
ADMIN_EMAIL=admin@melliebakehouse.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Mellie Admin
